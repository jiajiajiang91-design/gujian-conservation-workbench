# 只填在本机 .env 或部署平台的环境变量中，不要写进前端文件。
MOONSHOT_API_KEY=
PORT=8795

# 可选：新增 OpenAI Chat Completions 兼容供应商、模型和任务路由。
# 价格必须来自供应商官方页面，并填写来源与生效日期；未配置时产品不估算费用。
# AI_PROVIDERS_JSON=[{"id":"provider-id","label":"供应商","protocol":"openai-chat","baseUrl":"https://api.example.com/v1","apiKeyEnv":"PROVIDER_API_KEY"}]
# AI_MODELS_JSON=[{"id":"model-id","provider":"provider-id","upstreamModel":"model-name","label":"模型用途","capabilities":["text","json","tools","stream"],"policy":{"maxTokens":4000,"temperature":true,"responseFormat":true,"streamOptions":true},"pricing":{"currency":"CNY","inputPerMillion":0,"cachedInputPerMillion":0,"outputPerMillion":0,"source":"官方价格页","checkedAt":"YYYY-MM-DD"}}]
# AI_TASK_ROUTES_JSON={"intake.extract":["model-id","moonshot-text-standard"]}
# PROVIDER_API_KEY=

# 留空时只接受同源请求；需要分离部署时再填写完整来源，以英文逗号分隔。
ALLOWED_ORIGINS=

# 公开作品集的默认保护，可按测试需要调整。
AI_PER_MINUTE_LIMIT=6
AI_PER_DAY_LIMIT=80
AI_GLOBAL_DAY_LIMIT=300
AI_MAX_REQUEST_BYTES=6291456
AI_MAX_TOKENS=8000
