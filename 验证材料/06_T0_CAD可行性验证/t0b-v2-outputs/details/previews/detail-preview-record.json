    "findings": [
      {
        "priority": "P1",
        "viewId": "eaveDetail",
        "finding": "The source-resolved roof, tile laps, purlins and bearing chain are legible, but cropped members and the isolated upper purlin need break marks and relationship annotations in drawing output."
      },
      {
        "priority": "P1",
        "viewId": "bracketDetail",
        "finding": "The support chain is traceable, but the current team-demo bracket geometry remains schematic and cropped beam ends need professional break notation before L1 drawing review."
      },
      {
        "priority": "P1",
        "viewId": "columnBaseDetail",
        "finding": "The column, base, terrace and foundation layers are readable, but material hatches, level dimensions and construction annotations remain drawing-stage work."
      },
      {
        "priority": "P1",
        "viewId": "doorWindowDetail",
        "finding": "Two leaves, eight panels, two windows and twenty-four lattice cells are visually countable; joinery dimensions and annotation remain drawing-stage work."
      }
    ],
